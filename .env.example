# Database
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus

# Redis
REDIS_URL=redis://localhost:6379

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# LLM Backend (mock, openai, anthropic)
LLM_BACKEND=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Data Paths
DATA_DIR=/app/data
PARQUET_DIR=/app/data/parquet
FIXTURES_DIR=/app/data/fixtures

# Monitoring
LOG_LEVEL=INFO
